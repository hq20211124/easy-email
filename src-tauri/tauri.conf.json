{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Email",
  "version": "0.1.1",
  "identifier": "com.easyemail.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Easy Email — 邮件客户端",
        "width": 1200,
        "height": 780,
        "minWidth": 640,
        "minHeight": 460,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Easy Email",
    "shortDescription": "轻量邮件桌面客户端",
    "longDescription": "内置主流国内外邮箱配置，开箱即用的邮件桌面客户端。"
  }
}
